                "unit": "cm3"
              }
            },
            "bind": "bike"
          }
        }
      ],
      "expect": [
        {
          "get": {
            "subject": "bike",
            "property": "roadLegal"
          },
          "equals": true
        },
        {
          "get": {
            "subject": "bike",
            "property": "maxSpeed"
          },
          "equals": null
        },
        {
          "get": {
            "subject": "bike",
            "property": "engineDisplacement"
          },
          "equals": {
            "value": 600,
            "unit": "cm3"
          }
        }
      ]
    },
    {
      "file": "conformance/transport/vehicle_is_abstract.case.yaml",
      "id": "conf.transport.vehicle.abstract",
      "category": "structural",
      "description": "Vehicle is abstract, so it cannot be constructed; only its concrete kinds can.",
      "given": [
        {
          "construct": {
            "type": "wmoop.transport/Vehicle",
            "with": {
              "wheelCount": 4
            }
          }
        }
      ],
      "expect": {
        "outcome": "error",
        "error_code": "WM-ABSTRACT-INSTANTIATION"
      }
    },
    {
      "file": "conformance/transport/vehicle_classification.case.yaml",
      "id": "conf.transport.vehicle.classification",
      "category": "behaviour",
      "description": "Each kind of vehicle refines its classification down the extends chain. Hand-written behaviour that the bindings keep in step (ADR 0002).",
      "given": [
        {
          "construct": {
            "type": "wmoop.transport/Moped",
            "with": {
              "wheelCount": 2,
              "engineDisplacement": {
                "value": 49,
                "unit": "cm3"
              }
            },
            "bind": "moped"
          }
        },
        {
          "construct": {
            "type": "wmoop.transport/Motorcycle",
            "with": {
              "wheelCount": 2,
              "engineDisplacement": {
                "value": 600,
                "unit": "cm3"
              }
            },
            "bind": "bike"
          }
        }
      ],
      "expect": [
        {
          "get": {
            "subject": "moped",
            "property": "classification"
          },
          "equals": "moped"
        },
        {
          "get": {
            "subject": "bike",
            "property": "classification"
          },
          "equals": "motorcycle"
        }
      ]
    },
    {
      "file": "conformance/transport/max_speed_unit.case.yaml",
